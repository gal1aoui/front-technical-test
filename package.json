{
	"name": "angular-technical-test",
	"version": "1.0.0",
	"license": "MIT",
	"type": "module",
	"description": "Technical test for Frontend Engineer position at Ictechlab",
	"scripts": {
		"ng": "ng",
		"start": "npm run start:all",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"postinstall": "cd api && npm ci",
		"format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
		"format:write": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
		"start:all": "concurrently \"cd api && npm start\" \"ng serve --proxy-config proxy.conf.json\""
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "^20.2.14",
		"@ng-icons/core": "32.5.0",
		"@ng-icons/lucide": "32.5.0",
		"@ngrx/effects": "^20.1.0",
		"@ngrx/store": "^20.1.0",
		"@ngrx/store-devtools": "^20.1.0",
		"@spartan-ng/brain": "0.0.1-alpha.634",
		"@tailwindcss/postcss": "^4.1.18",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"glob": "^13.0.2",
		"inflight": "^1.0.6",
		"ngx-sonner": ">=3.0.0",
		"postcss": "^8.5.6",
		"rimraf": "^6.1.2",
		"rxjs": "~7.8.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.3.0",
		"tw-animate-css": "^1.4.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^20.3.16",
		"@angular/cli": "^20.3.16",
		"@angular/common": "^20.3.16",
		"@angular/compiler": "^20.3.16",
		"@angular/compiler-cli": "^20.3.16",
		"@angular/core": "^20.3.16",
		"@angular/forms": "^20.3.16",
		"@angular/platform-browser": "^20.3.16",
		"@angular/platform-browser-dynamic": "^20.3.16",
		"@angular/router": "^20.3.16",
		"@spartan-ng/cli": "^0.0.1-alpha.634",
		"@types/jasmine": "~5.1.0",
		"angular-eslint": "20.2.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"jasmine-core": "~5.6.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.40.0"
	},
	"overrides": {
		"@ng-icons/core": "32.5.0",
		"@ng-icons/lucide": "32.5.0"
	}
}
